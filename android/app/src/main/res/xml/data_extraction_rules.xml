<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and newer: the same rule for Google's cloud backup and for a phone-to-phone
     transfer: only the Metronom folder (songs.md, settings.md and setlists/). -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="Metronom" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="Metronom" />
    </device-transfer>
</data-extraction-rules>
